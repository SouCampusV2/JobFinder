# Copy to .env and fill in. Never commit .env.

# --- OpenAI (scoring) ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# --- Telegram (digest notifications) ---
# Create a bot via @BotFather -> get the token.
# Get your chat id via @userinfobot or the getUpdates API.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Public LinkedIn fetch (no login, guest endpoint) ---
SEARCH_QUERY=Product Operations
SEARCH_LOCATION=European Union
# How often the server fetches public jobs (minutes). 0 = disable scheduler.
SCRAPE_INTERVAL_MINUTES=30
# Only jobs posted within this many seconds. 3600 = last hour (best for
# "first to apply"), 86400 = last 24h.
LINKEDIN_TPR_SECONDS=86400
MAX_JOBS_PER_CYCLE=50

# --- UI filter labels ---
SEARCH_SOURCES=linkedin,glassdoor

# --- Web server ---
HOST=127.0.0.1
PORT=8000
# Extra origins allowed to call the API, on top of the Chrome extension and the
# app's own pages, which are always allowed. Leave empty unless you need one;
# "*" is ignored on purpose, since it would let any website read your CV.
CORS_ORIGINS=

# --- Storage ---
DB_PATH=data/jobs.db
